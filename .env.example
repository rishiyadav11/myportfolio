# Copy to .env.local and fill in. Never commit real values.

# Resend API key (https://resend.com/api-keys). Required for the contact form to send email.
# Without it the form shows a friendly "please email or WhatsApp me" message.
RESEND_API_KEY=

# Where contact form enquiries are delivered. Defaults to the email in src/content/site.ts.
CONTACT_TO_EMAIL=

# Sender address. Must be on a domain verified in Resend.
# Defaults to Resend's test sender: Website <onboarding@resend.dev>. Verify rishiyadav.space in Resend to use your own address.
CONTACT_FROM_EMAIL=

# Optional: a Google Apps Script web app URL that appends each enquiry to a Google Sheet.
# Receives a JSON POST. Failures here never block the email.
GOOGLE_SHEET_WEBHOOK_URL=

# Optional: Google Analytics 4 measurement ID (G-XXXXXXXXXX). Loads only after cookie consent.
NEXT_PUBLIC_GA_ID=
